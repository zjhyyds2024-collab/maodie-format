{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "耄耋格式",
  "version": "1.7.0",
  "identifier": "local.vert.enhanced",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "entitlements": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "14.0"
    },
    "resources": {
      "native-bin/": "native-bin/",
      "fonts/": "fonts/",
      "python/advanced_tools.py": "python/advanced_tools.py",
      "python/archive_tools.py": "python/archive_tools.py",
      "python/ncm_tools.py": "python/ncm_tools.py",
      "python/encrypted_music.py": "python/encrypted_music.py",
      "python/music_unlock/": "python/music_unlock/",
      "python/assets/": "python/assets/"
    }
  },
  "app": {
    "windows": [
      {
        "title": "耄耋格式 · 全能格式转换",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
